# Made by `node tools/build.mjs` from the pinned Rutba Office release; not
# committed because they hold the code's keys. packs/lang-en is committed:
# its English has its own wording in versions/en.medium.json. From Office
# 2.26.0, which keeps no Urdu, Arabic or Hindi words of its own, packs/lang-ar,
# lang-hi and lang-ur are committed like every other pack.
/ids.json
/labels.json

# The packs that may be released, written by tools/dist.mjs at each build.
/dist/

# Local working files: the copy of the Rutba Office code the build reads, and
# drafts in progress.
/work/
